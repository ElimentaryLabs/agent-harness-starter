# Copy this file to `.env` and fill in your key.
# Get a key at https://console.anthropic.com/settings/keys

ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides (defaults shown).
# The reasoning agent runs on Opus; per-page PDF extraction runs on a cheaper
# model as a bulk sub-task (the "cheaper model for the sub-task" pattern).
# HARNESS_MODEL=claude-opus-4-8
# HARNESS_PARSE_MODEL=claude-haiku-4-5
# HARNESS_MAX_ROUNDS=12
# HARNESS_TOKEN_BUDGET=120000
